\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Stochastic EDH flow on the range-bearing model: no correction (blue, RMSE $\approx 5.28$) versus with local correction $e_0 = h(\bar  {\boldsymbol  {\eta }}_0) - \mathbf  {H}\bar  {\boldsymbol  {\eta }}_0$ (green, RMSE $\approx 0.13$). True trajectory in black; observations as red crosses back-projected to position coordinates. The uncorrected run diverges because the global linearisation is stale throughout the flow; adding the local correction makes the same drift equation track the truth within one position unit.}}{34}{figure.17}\protected@file@percent }
\newlabel{fig:rb_sde_combined}{{17}{34}{Stochastic EDH flow on the range-bearing model: no correction (blue, RMSE $\approx 5.28$) versus with local correction $e_0 = h(\bar {\boldsymbol {\eta }}_0) - \mathbf {H}\bar {\boldsymbol {\eta }}_0$ (green, RMSE $\approx 0.13$). True trajectory in black; observations as red crosses back-projected to position coordinates. The uncorrected run diverges because the global linearisation is stale throughout the flow; adding the local correction makes the same drift equation track the truth within one position unit}{figure.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Stochastic EDH on the range-bearing model. `No correction' means $e_0 = 0$ and the drift is derived under pure global linearisation; `+ local correction' uses $e_0 = h(\bar  \eta _0) - H\bar  \eta _0$. `100 steps' forces a uniform $n_\lambda = 100$ grid; `optimal' uses the stiffness-mitigation schedule of \cite  {ding2012implementation}.}}{34}{table.6}\protected@file@percent }
\newlabel{tab:sde_flow}{{6}{34}{Stochastic EDH on the range-bearing model. `No correction' means $e_0 = 0$ and the drift is derived under pure global linearisation; `+ local correction' uses $e_0 = h(\bar \eta _0) - H\bar \eta _0$. `100 steps' forces a uniform $n_\lambda = 100$ grid; `optimal' uses the stiffness-mitigation schedule of \cite {ding2012implementation}}{table.6}{}}
