\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Range-bearing, EDH flow (blue) vs.\ EDH invertible (green). The two variants are visually indistinguishable: on this well-conditioned 2D model the per-particle log-determinants are close to unity at every flow step, so the Jacobian correction adds negligible information and adds negligible error. This is the control that says the correction is numerically harmless in the easy regime.}}{32}{figure.15}\protected@file@percent }
\newlabel{fig:edh_flow_vs_invertible_rb}{{15}{32}{Range-bearing, EDH flow (blue) vs.\ EDH invertible (green). The two variants are visually indistinguishable: on this well-conditioned 2D model the per-particle log-determinants are close to unity at every flow step, so the Jacobian correction adds negligible information and adds negligible error. This is the control that says the correction is numerically harmless in the easy regime}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Range-bearing, LEDH flow (blue) vs.\ LEDH invertible (green). The per-particle-linearisation version of the same comparison. Conclusion is identical: on a well-conditioned low-dimensional model the invertible correction neither helps nor hurts, and the empirical tie holds whether the underlying linearisation is global or local.}}{32}{figure.16}\protected@file@percent }
\newlabel{fig:ledh_flow_vs_invertible_rb}{{16}{32}{Range-bearing, LEDH flow (blue) vs.\ LEDH invertible (green). The per-particle-linearisation version of the same comparison. Conclusion is identical: on a well-conditioned low-dimensional model the invertible correction neither helps nor hurts, and the empirical tie holds whether the underlying linearisation is global or local}{figure.16}{}}
