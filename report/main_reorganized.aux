\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Range-bearing filter comparison ($N=200$, $T=100$, $n_\lambda =29$). All RMSE values are in position units. The `EDH global' row uses a single global linearisation at $\lambda =0$ and is the essential control --- it diverges, which is what motivates intermediate re-linearisation for every other variant.}}{24}{table.2}\protected@file@percent }
\newlabel{tab:edh-rb}{{2}{24}{Range-bearing filter comparison ($N=200$, $T=100$, $n_\lambda =29$). All RMSE values are in position units. The `EDH global' row uses a single global linearisation at $\lambda =0$ and is the essential control --- it diverges, which is what motivates intermediate re-linearisation for every other variant}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Range-bearing: bootstrap PF (blue), EDH flow (green), and LEDH flow (orange) overlaid on the true trajectory (black), with back-projected observations as red crosses. The three filters are visually indistinguishable on this well-conditioned model --- the per-model ranking in Table~\ref {tab:edh-rb} is driven primarily by wall-time; log-likelihood differs by a few nats but RMSE is tied to three decimal places.}}{25}{figure.9}\protected@file@percent }
\newlabel{fig:pf_edh_ledh_rb}{{9}{25}{Range-bearing: bootstrap PF (blue), EDH flow (green), and LEDH flow (orange) overlaid on the true trajectory (black), with back-projected observations as red crosses. The three filters are visually indistinguishable on this well-conditioned model --- the per-model ranking in Table~\ref {tab:edh-rb} is driven primarily by wall-time; log-likelihood differs by a few nats but RMSE is tied to three decimal places}{figure.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Acoustic-tracking filter comparison ($T = 100$ except where noted). The high-dimensional state and weak observation geometry make this the hardest of the three headline models; none of the filters reach the same relative accuracy they do on range-bearing, and the ranking is driven as much by particle count and hyperparameter choice as by algorithm.}}{25}{table.3}\protected@file@percent }
\newlabel{tab:edh-acoustic}{{3}{25}{Acoustic-tracking filter comparison ($T = 100$ except where noted). The high-dimensional state and weak observation geometry make this the hardest of the three headline models; none of the filters reach the same relative accuracy they do on range-bearing, and the ranking is driven as much by particle count and hyperparameter choice as by algorithm}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Stochastic volatility, \emph  {raw} model ($h(x)=\beta e^{x/2}v$, multiplicative noise; $T=100$, $N=200$). Every linearisation-based method fails at ${\sim }2.0$ RMSE; only the bootstrap PF handles the raw multiplicative likelihood.}}{26}{table.4}\protected@file@percent }
\newlabel{tab:edh-sv-raw}{{4}{26}{Stochastic volatility, \emph {raw} model ($h(x)=\beta e^{x/2}v$, multiplicative noise; $T=100$, $N=200$). Every linearisation-based method fails at ${\sim }2.0$ RMSE; only the bootstrap PF handles the raw multiplicative likelihood}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Stochastic volatility, \emph  {log-squared-transformed} model ($z = \log y^2$; $T=100$, $N=200$). The linear transform restores competitiveness to EKF/UKF and the flow family; kernel is slower but still tracks. LEDH-invertible is in the same narrow RMSE band as bootstrap PF, but does not beat it.}}{26}{table.5}\protected@file@percent }
\newlabel{tab:edh-sv-log}{{5}{26}{Stochastic volatility, \emph {log-squared-transformed} model ($z = \log y^2$; $T=100$, $N=200$). The linear transform restores competitiveness to EKF/UKF and the flow family; kernel is slower but still tracks. LEDH-invertible is in the same narrow RMSE band as bootstrap PF, but does not beat it}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Log-squared stochastic volatility: bootstrap PF (blue), EDH flow (green), and LEDH flow (orange) compared against the true log-volatility (black) with back-projected observations as red crosses. After the log-squared transform, the three filters compress into a narrow band and the differences between them become invisible at this scale; the three filters all land in the same narrow RMSE band as the LEDH-invertible entry in Table~\ref {tab:edh-sv-log}.}}{26}{figure.10}\protected@file@percent }
\newlabel{fig:pf_edh_ledh_sv_log}{{10}{26}{Log-squared stochastic volatility: bootstrap PF (blue), EDH flow (green), and LEDH flow (orange) compared against the true log-volatility (black) with back-projected observations as red crosses. After the log-squared transform, the three filters compress into a narrow band and the differences between them become invisible at this scale; the three filters all land in the same narrow RMSE band as the LEDH-invertible entry in Table~\ref {tab:edh-sv-log}}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Log-squared stochastic volatility, EDH flow (blue) vs.\ LEDH flow (green). The pairwise comparison isolates the effect of per-particle re-linearisation (LEDH) against a single global linearisation per time step (EDH) on the transformed model. Per-particle re-linearisation buys essentially nothing here: the two trajectories overlap within plot precision.}}{27}{figure.11}\protected@file@percent }
\newlabel{fig:edh_vs_ledh_flow_sv_log}{{11}{27}{Log-squared stochastic volatility, EDH flow (blue) vs.\ LEDH flow (green). The pairwise comparison isolates the effect of per-particle re-linearisation (LEDH) against a single global linearisation per time step (EDH) on the transformed model. Per-particle re-linearisation buys essentially nothing here: the two trajectories overlap within plot precision}{figure.11}{}}
\@writefile{toc}{\contentsline {paragraph}{Stochastic volatility 2D (filter accuracy).}{27}{section*.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Stochastic volatility 2D: bootstrap PF (blue), EDH flow (green), LEDH flow (orange), overlaid on the true state (black). The first state component $x^{(1)}$ is the linear drift driver; the second $x^{(2)}$ is the log-volatility scale. Back-projected observations (red crosses) are shown only on the first panel because the SV2D observation model has a scalar output $y_t = b\,x_t^{(1)} + \exp (x_t^{(2)}/2)\,v_t$ with no per-dimension back-projection of $x^{(2)}$.}}{27}{figure.12}\protected@file@percent }
\newlabel{fig:pf_edh_ledh_sv2d}{{12}{27}{Stochastic volatility 2D: bootstrap PF (blue), EDH flow (green), LEDH flow (orange), overlaid on the true state (black). The first state component $x^{(1)}$ is the linear drift driver; the second $x^{(2)}$ is the log-volatility scale. Back-projected observations (red crosses) are shown only on the first panel because the SV2D observation model has a scalar output $y_t = b\,x_t^{(1)} + \exp (x_t^{(2)}/2)\,v_t$ with no per-dimension back-projection of $x^{(2)}$}{figure.12}{}}
\citation{Li-Particle-Filtering-2017}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Stochastic volatility 2D, EDH flow (blue) vs.\ EDH invertible (green). Both share the same global linearisation per time step; only the Jacobian correction differs. On this high-dimensional nonlinear target the two variants diverge visibly in places (max mean difference ${\approx }3.2$ in the log-volatility component), more than on range-bearing where the correction is essentially free.}}{28}{figure.13}\protected@file@percent }
\newlabel{fig:edh_flow_vs_invertible_sv2d}{{13}{28}{Stochastic volatility 2D, EDH flow (blue) vs.\ EDH invertible (green). Both share the same global linearisation per time step; only the Jacobian correction differs. On this high-dimensional nonlinear target the two variants diverge visibly in places (max mean difference ${\approx }3.2$ in the log-volatility component), more than on range-bearing where the correction is essentially free}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Stochastic volatility 2D, EDH invertible (blue) vs.\ LEDH invertible (green). Both carry the Jacobian correction; only the linearisation scheme differs (global vs.\ per-particle). On SV2D the per-particle LEDH variant is \emph  {not} consistently better than global-EDH; the two filters cross each other in places and the ranking is not decisive.}}{28}{figure.14}\protected@file@percent }
\newlabel{fig:edh_vs_ledh_invertible_sv2d}{{14}{28}{Stochastic volatility 2D, EDH invertible (blue) vs.\ LEDH invertible (green). Both carry the Jacobian correction; only the linearisation scheme differs (global vs.\ per-particle). On SV2D the per-particle LEDH variant is \emph {not} consistently better than global-EDH; the two filters cross each other in places and the ranking is not decisive}{figure.14}{}}
